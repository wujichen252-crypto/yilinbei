    "/api/committee/export/data": {
      "get": {
        "operationId": "apps_api_views_committee_export_data",
        "summary": "Committee Export Data",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "description": "组委会按组导出整组报名。\n\n数据范围以原版 ``Api\\ExportController::exportReportData`` 为基准：只按可选\n``group`` 过滤、``id`` 升序、无 ``user_id``/状态条件，输出同一套 19 列。\n原版该接口只挂了 ``auth:sanctum``（``routes/api.php:58-62``，无角色中间件），\n组委会是借它做整组导出的；本接口补上原版缺失的角色门禁（``type=2``），\n从而把\"整组导出\"与 ``/export/data`` 的\"仅本人导出\"分开，两个数据范围互不干扰。",
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
