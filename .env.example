# PostgreSQL 9.6 development database
DB_ENGINE=django.db.backends.postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ylb
DB_USER=postgres
DB_PASSWORD=123456
DB_CONN_MAX_AGE=60

# Production GaussDB values. Set DB_ENGINE to the validated backend supplied by the vendor.
GAUSSDB_ENGINE=django.db.backends.postgresql
GAUSSDB_HOST=
GAUSSDB_PORT=8000
GAUSSDB_NAME=
GAUSSDB_USER=
GAUSSDB_PASSWORD=
GAUSSDB_OPTIONS={}
GAUSSDB_COMPATIBILITY_MODE=unknown

MEDIA_ROOT=media
MEDIA_URL=/media/
STATIC_ROOT=staticfiles
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=
TOKEN_TTL_HOURS=4
REDIS_URL=redis://127.0.0.1:6379/0
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True