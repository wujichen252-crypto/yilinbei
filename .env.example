DJANGO_SETTINGS_MODULE=django_config.settings
SECRET_KEY=replace-with-a-long-random-value
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# LAN real-device debugging (phone visiting http://<dev-ip>:8080). Values are
# comma-separated full-match regexes, so a regex containing a comma cannot be
# expressed here. Never use CORS_ALLOW_ALL_ORIGINS=True: /api/ticket/* is
# public and returns personal data.
# CORS_ALLOWED_ORIGIN_REGEXES=^http://192\.168\.\d+\.\d+:8080$
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Public deployment: API on a public IP, frontend served via a natappfree
# tunnel. Free natapp tunnels get a random subdomain on every restart, so
# whitelist the suffix with a leading dot (ALLOWED_HOSTS) and a full-match
# regex (CORS) instead of the current subdomain. Update CSRF_TRUSTED_ORIGINS
# manually when the tunnel subdomain changes (no regex support there).
# ALLOWED_HOSTS=localhost,127.0.0.1,47.108.29.34,.natappfree.cc
# CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://47.108.29.34
# CORS_ALLOWED_ORIGIN_REGEXES=^http://[a-z0-9-]+\.natappfree\.cc$
# CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:5173,http://wa9b8afb.natappfree.cc
TIME_ZONE=Asia/Shanghai

# PostgreSQL 9.2.4 development database
DB_ENGINE=django.db.backends.postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ylb
DB_USER=postgres
DB_PASSWORD=change-me
DB_CONN_MAX_AGE=60

# Production GaussDB values. Set DB_ENGINE to the validated backend supplied by the vendor.
GAUSSDB_ENGINE=django.db.backends.postgresql
GAUSSDB_HOST=
GAUSSDB_PORT=8000
GAUSSDB_NAME=
GAUSSDB_USER=
GAUSSDB_PASSWORD=
GAUSSDB_OPTIONS={}
GAUSSDB_COMPATIBILITY_MODE=unknown

MEDIA_ROOT=media
MEDIA_URL=/media/
STATIC_ROOT=staticfiles
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=

# Aliyun OSS direct upload (STS). Bucket stays PRIVATE; long-lived keys live
# only here. The RAM role ARN must allow PutObject/AbortMultipartUpload/
# ListParts/ListMultipartUploads — the per-request session policy narrows it
# to the upload's own key prefix.
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_REGION=oss-cn-chengdu
ALIYUN_OSS_ENDPOINT=oss-cn-chengdu.aliyuncs.com
ALIYUN_OSS_HOST=
ALIYUN_OSS_STS_ROLE_ARN=
ALIYUN_OSS_STS_EXPIRE=3600
TOKEN_TTL_HOURS=4
REDIS_URL=redis://127.0.0.1:6379/0
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
